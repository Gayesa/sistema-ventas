# ============================================
# SISTEMA VENTAS SaaS — Environment Variables Template
# Copy this file to .env and fill in real values
# ============================================

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE=sistema_ventas
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRATION=8h

# App
PORT=3000
CORS_ORIGIN=http://localhost
NODE_ENV=production
